// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum School {
  PUBLICO
  PRIVADO
}

enum StatusMatricula {
  PENDENTE
  CONFIRMADO
  REJEITADO
}

enum Role {
  ADMIN
  MEMBER
  PROFESSOR
}

enum Aluno {
  ALUNO
  RESPONSAVEL
}

enum StatusAgendamentos {
  AGENDADO
  REALIZADO
  CANCELADO
}

model escola {
  id          String @id @default(uuid())
  name        String
  adress      String
  email       String @unique
  type        School @default(PUBLICO)
  Description String

  matricula    matricula[]
  agendamentos agendamentos[]
  feedback     feedback[]
  Exame        Exame[]
  aulas        aula[]
  turmas       turma[]
  atividades   atividade[]

  @@map("schools")
}

model User {
  id            String        @id @unique @default(uuid())
  nome          String
  email         String        @unique
  password_hash String
  number        String
  createdAt     DateTime      @default(now())
  role          Role          @default(MEMBER)
  Aluno         Aluno         @default(ALUNO)
  matricula     matricula[] //se for responsavel mais de um aluno
  Exame         Exame[]
  feedback      feedback[]
  notificacao   notificacao[]
  aulaAoVivo    aulaAoVivo[]
  aulas         aula[]
  turma         turma?        @relation("turma_alunos", fields: [turmaId], references: [id])
  turmaId       String?
  turmaLecionada turma[]      @relation("turma_professor")
  atividades    atividade[]
  atividadesRealizadas atividade_realizada[]

  @@map("users")
}

model matricula {
  id        String          @id @default(uuid())
  createdAt DateTime        @default(now())
  status    StatusMatricula @default(PENDENTE)
  escola    escola          @relation(fields: [escolaId], references: [id])
  escolaId  String
  user      User            @relation(fields: [userId], references: [id])
  userId    String

  @@map("matricula")
}

model Exame {
  id          Int       @id @default(autoincrement())
  Questions   String
  Answers     String
  CreatedAt   DateTime  @default(now())
  validatedAt DateTime?
  escola      escola    @relation(fields: [escolaId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  escolaId    String
}

model agendamentos {
  id        Int                @id @default(autoincrement())
  CreatedAt DateTime           @default(now())
  status    StatusAgendamentos
  exames    escola             @relation(fields: [escolaId], references: [id])
  escolaId  String
}

model feedback {
  id       String @id @default(uuid())
  mark     String //de 1 a 5 
  user     User   @relation(fields: [userId], references: [id])
  comment  String
  userId   String
  escola   escola @relation(fields: [escolaId], references: [id])
  escolaId String
}

model notificacao {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String

  @@map("notif")
}

model aulaAoVivo {
  id        String             @id @default(uuid())
  tema      String
  materia   String
  professor String            @default("A confirmar")
  data      DateTime
  hora      String
  status    StatusAgendamentos @default(AGENDADO)
  user      User               @relation(fields: [userId], references: [id])
  userId    String
  turma     turma?             @relation(fields: [turmaId], references: [id])
  turmaId   String?
  createdAt DateTime           @default(now())

  @@map("aulas_ao_vivo")
}

model aula {
  id            Int      @id @default(autoincrement())
  titulo        String
  professor     String
  materia       String
  duracao       String
  visualizacoes Int      @default(0)
  data          String
  thumbnail     String   @default("azul")
  descricao     String
  topicos       String[]
  videoUrl      String?
  user          User?    @relation(fields: [userId], references: [id])
  userId        String?
  escola        escola?  @relation(fields: [escolaId], references: [id])
  escolaId      String?
  turma         turma?   @relation(fields: [turmaId], references: [id])
  turmaId       String?

  @@map("aulas")
}

model turma {
  id          String      @id @default(uuid())
  nome        String
  materia     String
  status      String      @default("ativo")
  professor   User        @relation("turma_professor", fields: [professorId], references: [id])
  professorId String
  escola      escola      @relation(fields: [escolaId], references: [id])
  escolaId    String
  alunos      User[]      @relation("turma_alunos")
  aulas       aula[]
  aulasAoVivo aulaAoVivo[]
  atividades  atividade[]

  @@map("turmas")
}

model atividade {
  id            Int                  @id @default(autoincrement())
  titulo        String
  professor     String               @default("")
  materia       String
  pontos        Int                  @default(10)
  dificuldade   String               @default("Facil")
  descricao     String               @default("")
  tempoEstimado String               @default("10 min")
  cor           String               @default("azul")
  icone         String               @default("file")
  perguntas     Json
  respondidas   Int                  @default(0)
  createdAt     DateTime             @default(now())
  user          User?                @relation(fields: [userId], references: [id])
  userId        String?
  escola        escola?              @relation(fields: [escolaId], references: [id])
  escolaId      String?
  turma         turma?               @relation(fields: [turmaId], references: [id])
  turmaId       String?
  realizadas    atividade_realizada[]

  @@map("atividades")
}

model atividade_realizada {
  id           Int       @id @default(autoincrement())
  atividade    atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  atividadeId  Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  acertos      Int       @default(0)
  erros        Int       @default(0)
  pontosGanhos Int       @default(0)
  createdAt    DateTime  @default(now())

  @@unique([atividadeId, userId])
  @@map("atividades_realizadas")
}